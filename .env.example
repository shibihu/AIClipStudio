# Rename to .env for local use — on Render, set these in Dashboard → Environment.
# At least one LLM key is required for AI editing (your local engine is the fallback only).

# Google AI Studio key — https://aistudio.google.com/apikey
# Local: rename this file to .env and put the key after the "=".
# Render/deployed: set GEMINI_API_KEY in the service's Environment settings.
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-flash-latest, falls back to
# gemini-flash-lite-latest when the primary is unavailable/overloaded).
# Comma-separated lists are allowed, e.g. GEMINI_MODEL=gemini-flash-latest,gemini-3.8-flash
GEMINI_MODEL=
GEMINI_FALLBACK=

# Optional competing providers (first configured key wins, in this order:
# Gemini → OpenAI → OpenRouter → Groq → OpenCode Zen → Anthropic)
OPENAI_API_KEY=
OPENAI_MODEL=

# OpenRouter — https://openrouter.ai/keys (OpenAI-compatible)
OPENROUTER_API_KEY=
# Default is openrouter/auto; set any slug, e.g. openai/gpt-4o-mini
OPENROUTER_MODEL=

# Groq — https://console.groq.com/keys (OpenAI-compatible)
GROQ_API_KEY=
# Default is openai/gpt-oss-120b
GROQ_MODEL=

# OpenCode Zen — https://opencode.ai/auth (OpenAI-compatible chat completions)
OPENCODE_API_KEY=
# Default is deepseek-v4-flash
OPENCODE_MODEL=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional: when set, every API/media route requires this token (a login box).
# Render health checks hit /api/health, which stays open on purpose.
AUTH_TOKEN=

# Optional: how long finished projects are kept on disk (hours, default 24)
JOBS_TTL_HOURS=24

# Optional: per-request LLM HTTP timeout in ms (default 45000). A hung LLM
# connection now fails within this window and falls back to the offline engine
# instead of stalling the chat for minutes.
LLM_TIMEOUT_MS=
